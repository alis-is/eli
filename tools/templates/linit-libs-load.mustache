	/* eli additional libs */
	luaL_getsubtable(L, LUA_REGISTRYINDEX, LUA_PRELOAD_TABLE);
	for (lib = preloadedlibs; lib->func; lib++) {
		lua_pushcfunction(L, lib->func);
		lua_setfield(L, -2, lib->name);
	}
	lua_pop(L, 1);  /* remove _PRELOAD table */
	int arg = lua_gettop(L);
{{#compress}}
	char uncompressedLibs[{{{embedableLibsLength}}}];
	z_stream i_stream;
	i_stream.zalloc = Z_NULL;
	i_stream.zfree = Z_NULL;
	i_stream.opaque = Z_NULL;

	i_stream.avail_in = (uInt)sizeof(lua_libs);           // size of input
	i_stream.next_in = (Bytef *)lua_libs;                 // input char array
	i_stream.avail_out = (uInt)sizeof(uncompressedLibs);  // size of output
	i_stream.next_out = (Bytef *)uncompressedLibs;        // output char array

	uLong uncompressedSize = 0;
	int zstatus = inflateInit(&i_stream);
	if (zstatus == Z_OK) {
		zstatus = inflate(&i_stream, Z_NO_FLUSH);
		uncompressedSize = i_stream.total_out;
		inflateEnd(&i_stream);
	}
	if (zstatus != Z_STREAM_END) {
		lua_pushliteral(L, "failed to decompress embedded lua libraries");
		lua_error(L);
	}
	int status = luaL_loadbuffer(L, uncompressedLibs, (size_t)uncompressedSize, "preload-libs");
{{/compress}}
{{^compress}}
	int status = luaL_loadbuffer(L, lua_libs, {{{embedableLibsLength}}}, "preload-libs");
{{/compress}}
	if (status != LUA_OK) {
		lua_error(L);
	}
	lua_insert(L,1);
	lua_call(L,arg,1);
	/* end eli additional libs */
